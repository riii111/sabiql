#!/usr/bin/env python3
"""Synthetic MySQL XML peer. No DB connection, credentials, or SQL execution."""
import json
import os
import re
import socket
import sys
import time
from xml.sax.saxutils import escape

LOG = os.environ['CF14_LOG']
COUNT = int(os.environ['CF14_TABLES'])
DELAY = int(os.environ['CF14_DELAY_MS']) / 1000
PID = os.getpid()


def event(kind, **values):
    with open(LOG, 'a') as stream:
        stream.write(json.dumps(dict(kind=kind, pid=PID, ns=time.time_ns(), **values)) + '\n')


def xml(rows):
    return '<resultset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">' + ''.join(
        '<row>' + ''.join(f'<field name="{key}" xsi:nil="true"/>' if value is None else
                         f'<field name="{key}">{escape(str(value))}</field>'
                         for key, value in row.items()) + '</row>' for row in rows) + '</resultset>\n'


def table(name):
    return dict(TABLE_SCHEMA='app', TABLE_NAME=name, TABLE_TYPE='BASE TABLE', TABLE_ROWS='100',
                TABLE_COMMENT='', ENGINE='InnoDB', ROW_FORMAT='Dynamic',
                TABLE_COLLATION='utf8mb4_0900_ai_ci', CREATE_OPTIONS='')


def column():
    return dict(COLUMN_NAME='id', COLUMN_TYPE='int', IS_NULLABLE='NO', COLUMN_DEFAULT=None,
                EXTRA='', COLUMN_COMMENT=None, ORDINAL_POSITION='1', PRIMARY_KEY_POSITION='1',
                CHARACTER_SET_NAME=None, COLLATION_NAME=None, GENERATION_EXPRESSION=None)


def response(sql):
    marker = re.search(r"SELECT '([^']+)' AS (__sabiql_\w+)", sql)
    if marker:
        row = {marker[2]: marker[1]}
        if marker[2] == '__sabiql_session_marker':
            row['__sabiql_sql_mode'] = 'STRICT_TRANS_TABLES'
        if marker[2] == '__sabiql_probe':
            row.update(__sabiql_server_version='8.4.10', __sabiql_lower_case_table_names='0')
        return xml([row])
    if 'SELECT VERSION()' in sql:
        return xml([dict(__sabiql_server_version='8.4.10', __sabiql_sql_mode='STRICT_TRANS_TABLES', __sabiql_lower_case_table_names='0')])
    if sql.startswith('SET '):
        return ''
    if 'CURRENT_USER()' in sql:
        return xml([{'CURRENT_USER()': 'fixture@localhost'}])
    if 'FROM INFORMATION_SCHEMA.TABLES' in sql and 'FROM INFORMATION_SCHEMA.COLUMNS' not in sql:
        names = ['items'] if 't.TABLE_NAME =' in sql else ['items'] + [f't{i:04}' for i in range(1, COUNT)]
        return xml([table(name) for name in names])
    if 'INFORMATION_SCHEMA.COLUMNS' in sql:
        col = column()
        for key in ['CHARACTER_SET_NAME', 'COLLATION_NAME', 'GENERATION_EXPRESSION']:
            if key not in sql:
                col.pop(key)
        if 'SELECT c.TABLE_SCHEMA' in sql:
            return xml([dict(TABLE_SCHEMA='app', TABLE_NAME=name, **col) for name in ['items'] + [f't{i:04}' for i in range(1, COUNT)]])
        return xml([col])
    if any(name in sql for name in ['INFORMATION_SCHEMA.STATISTICS', 'INFORMATION_SCHEMA.KEY_COLUMN_USAGE', 'INFORMATION_SCHEMA.REFERENTIAL_CONSTRAINTS', 'INFORMATION_SCHEMA.TRIGGERS']):
        return xml([])
    if sql.startswith('SHOW CREATE TABLE'):
        return xml([{'Table': 'items', 'Create Table': 'CREATE TABLE items (id int PRIMARY KEY)'}])
    if 'FROM `app`.`items`' in sql:
        if sql == 'SELECT id FROM `app`.`items`':
            rows = int(os.environ.get('CF14_CSV_ROWS', '50'))
            if not 0 < rows <= 1000:
                raise RuntimeError('CSV fixture row budget exceeded')
            output = xml([dict(id=str(i)) for i in range(rows)])
            if os.environ.get('CF14_CSV_FAULT') == 'truncate':
                return output.rsplit('</resultset>', 1)[0]
            return output
        aliases = re.findall(r'AS `([^`]+)`', sql)
        offset = 50 if 'OFFSET 50' in sql else 0
        return xml([dict(id=str(i), **{alias: str(i) for alias in aliases}) for i in range(offset, offset + 50)])
    raise RuntimeError('unsupported synthetic SQL: ' + sql)


def execute(sql):
    sql = sql.strip().rstrip(';').strip()
    if not sql:
        return
    output = response(sql)
    event('sql', sql=re.sub(r"'[a-f0-9]{32}'", "'<marker>'", sql), input_bytes=len(sql.encode()), output_bytes=len(output.encode()))
    if output and os.environ.get('CF14_FAULT_PORT'):
        with socket.create_connection(('127.0.0.1', int(os.environ['CF14_FAULT_PORT']))) as peer:
            event('loopback_connected')
            peer.settimeout(40)
            peer.recv(1)
        print('ERROR 2013 (HY000): Lost connection to synthetic loopback peer', file=sys.stderr)
        sys.exit(1)
    if output:
        time.sleep(DELAY)
        sys.stdout.write(output)
        sys.stdout.flush()
        if sql == 'SELECT id FROM `app`.`items`' and os.environ.get('CF14_CSV_FAULT') == 'truncate':
            print('ERROR 2013 (HY000): synthetic CSV truncation', file=sys.stderr)
            sys.exit(1)


event('start')
try:
    if '--version' in sys.argv:
        print('mysql  Ver 8.4.10 for synthetic fixture')
    elif any(arg.startswith('--execute=') for arg in sys.argv):
        execute(next(arg.split('=', 1)[1] for arg in sys.argv if arg.startswith('--execute=')))
    else:
        pending = ''
        for line in sys.stdin:
            if '\x04' in line:
                break
            pending += line
            if ';' in line:
                for statement in pending.split(';')[:-1]:
                    execute(statement)
                pending = pending.rsplit(';', 1)[-1]
finally:
    event('exit')
