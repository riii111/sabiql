---
source: src/tests/keymap_baseline.rs
expression: "capture_matrix(engine, preset)"
---
## Normal
BeginKeySequence(Z): 'z', ^'z', ⌥'z', ^⌥'z', ⇧'z', ^⇧'z'
ConfirmSelection: Enter, ⇧Enter
EnterCommandLine: ':'
Escape: Esc, ⇧Esc
OpenModal(CommandPalette): 'P'
OpenModal(ConnectionSelector): 'c'
OpenModal(QueryHistoryPicker): 'O'
OpenModal(Settings): ','
OpenModal(SqlModal): 's'
OpenModal(SqliteDiagnostics): 'D'
OpenModal(TablePicker): 'T'
Quit: 'q'
ReloadMetadata: 'r'
Scroll { target: Explorer, direction: Left, amount: Line }: 'h', Left
Scroll { target: Explorer, direction: Right, amount: Line }: 'l', Right
Select(First): 'g', Home
Select(FullPageDown): ^'f', PageDown
Select(FullPageUp): ^'b', PageUp
Select(HalfPageDown): ^'d'
Select(HalfPageUp): ^'u'
Select(Last): 'G', End
Select(Next): 'j', Down
Select(Previous): 'k', Up
Select(ViewportBottom): 'L'
Select(ViewportMiddle): 'M'
Select(ViewportTop): 'H'
SetFocusedPane(Explorer): '1', ^'1', ⌥'1', ^⌥'1', ⇧'1', ^⇧'1'
SetFocusedPane(Inspector): '2', ^'2', ⌥'2', ^⌥'2', ⇧'2', ^⇧'2'
SetFocusedPane(Result): '3', ^'3', ⌥'3', ^⌥'3', ⇧'3', ^⇧'3'
ToggleFocus: 'f'
ToggleHelp: '?'
ToggleReadOnly: 'R'
