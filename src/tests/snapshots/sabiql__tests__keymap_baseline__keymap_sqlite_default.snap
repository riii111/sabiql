TextKill { target: CommandLine, direction: ReadlinePreviousWhitespace }: ^'w'
TextKill { target: CommandLine, direction: ReadlineWordEnd }: ⌥'d'
TextKill { target: CommandLine, direction: ToLineEnd }: ^'k'
TextKill { target: CommandLine, direction: ToLineStart }: ^'u'
TextMoveCursor { target: CommandLine, direction: Left }: ^'b', Left, ^Left, ⌥Left, ^⌥Left, ⇧Left, ^⇧Left
TextMoveCursor { target: CommandLine, direction: LineEnd }: ^'e', End, ^End, ⌥End, ^⌥End, ⇧End, ^⇧End
TextMoveCursor { target: CommandLine, direction: LineStart }: ^'a', Home, ^Home, ⌥Home, ^⌥Home, ⇧Home, ^⇧Home
TextMoveCursor { target: CommandLine, direction: ReadlineWordEnd }: ⌥'f'
TextMoveCursor { target: CommandLine, direction: ReadlineWordStart }: ⌥'b'
TextMoveCursor { target: CommandLine, direction: Right }: ^'f', Right, ^Right, ⌥Right, ^⌥Right, ⇧Right, ^⇧Right
TextYank { target: CommandLine }: ^'y'
